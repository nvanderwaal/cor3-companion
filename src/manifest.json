{
  "manifest_version": 3,
  "name": "COR3 Companion",
  "version": "1.3.1",
  "description": "Unofficial helpers for cor3.gg: puzzle solvers, a job tracker with routes, upgrade checks, expedition odds and item prices.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "COR3 Companion",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "host_permissions": [
    "*://cor3.gg/*",
    "*://*.cor3.gg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://cor3.gg/*",
        "*://*.cor3.gg/*"
      ],
      "js": [
        "shared/helpers-list.js",
        "shared/core.js",
        "shared/toggles.js",
        "shared/msgpack.js",
        "shared/socket.js",
        "helpers/jobs/jobs.js",
        "helpers/loadout/loadout.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://cor3.gg/*",
        "*://*.cor3.gg/*"
      ],
      "js": [
        "helpers/icewall/icewall.js",
        "helpers/protocol/protocol.js",
        "helpers/dailyops/dailyops.js",
        "helpers/expeditions/expeditions.js",
        "helpers/inventory/drone.js",
        "helpers/inventory/inventory.js",
        "helpers/lighter/lighter.js",
        "helpers/topbar/topbar.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://cor3.gg/*",
        "*://*.cor3.gg/*"
      ],
      "js": [
        "shared/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "icewall-helper@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
